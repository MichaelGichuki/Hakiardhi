
generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String       @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  role      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
}

model LandParcels {
    id String @id @default(uuid()) @db.Uuid
    parcelNumber String @unique
    lat Float
    log Float
    Size Float
    county String
    tenure String
    parcelOriginId String? @db.Uuid
    parcelOrigin LandParcels? @relation("ParcelLineage", references: [id], fields: [parcelOriginId])
    isActive Boolean
    createdAt DateTime
    updateAt DateTime
    ownershipRecords OwnershipRecords?
    landParcels LandParcels[] @relation("ParcelLineage")
}


model LandOwner {
    id String @id @default(uuid()) @db.Uuid
    name String
    registration String @unique
    phoneNumber String
    createdAt DateTime
    updateAt DateTime
    ownershipRecords OwnershipRecords[]
}

model OwnershipRecords {
  id String @id @default(uuid()) @db.Uuid
  landParcelId String @unique @db.Uuid
  landParcel LandParcels @relation(references: [id], fields: [landParcelId])
  landOwnerId String @db.Uuid
  landOwner LandOwner @relation(fields: [landOwnerId], references: [id])
  legerRefernce String
  registeredAt String
  sha256 String
  blockchainRecord String
  createdAt DateTime
  updateAt DateTime
}

model TransactionHistory {
  id String @id @default(uuid()) @db.Uuid
  refrerence String @unique
  actor String
  action String
  status String
  createdAt DateTime
  updateAt DateTime
}


model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  userAgent        String?
  ipAddress        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

